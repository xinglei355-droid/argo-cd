+func TestGetApp_ResourceNotFound(t *testing.T) {
+	ctx := t.Context()
+	appServer := newTestAppServer(t)
+
+	appName := "non-existent-app"
+	_, err := appServer.Get(ctx, &application.ApplicationQuery{Name: &appName})
