+// appQueryContext 包含应用查询所需的所有上下文信息
+type appQueryContext struct {
+	ctx            context.Context
+	action         string
+	project        string
+	namespace      string
+	name           string
+	resourceVersion string
+	claims         any
+	subject        string
+}
+
+// appQueryContextBuilder 用于构建 appQueryContext
+type appQueryContextBuilder struct {
+	s              *Server
+	ctx            context.Context
+	action         string
+	queryProject   string
+	queryProjects  []string
+	queryNamespace string
+	queryName      string
+	resourceVersion string
+	allowMultipleProjects bool
+}
+
+// newAppQueryContextBuilder 创建一个新的应用查询上下文构建器
+func (s *Server) newAppQueryContextBuilder(ctx context.Context, action string) *appQueryContextBuilder {
+	return &appQueryContextBuilder{
+		s:      s,
+		ctx:    ctx,
+		action: action,
+	}
+}
+
+// withProjectQuery 设置项目查询参数（单个项目）
+func (b *appQueryContextBuilder) withProjectQuery(project string) *appQueryContextBuilder {
+	b.queryProject = project
+	return b
+}
+
+// withProjectsQuery 设置项目查询参数（多个项目）
+func (b *appQueryContextBuilder) withProjectsQuery(projects []string) *appQueryContextBuilder {
+	b.queryProjects = projects
+	return b
+}
+
+// withNamespaceQuery 设置命名空间查询参数
+func (b *appQueryContextBuilder) withNamespaceQuery(namespace string) *appQueryContextBuilder {
+	b.queryNamespace = namespace
+	return b
+}
+
+// withNameQuery 设置应用名称查询参数
+func (b *appQueryContextBuilder) withNameQuery(name string) *appQueryContextBuilder {
+	b.queryName = name
+	return b
+}
+
+// withResourceVersion 设置资源版本
+func (b *appQueryContextBuilder) withResourceVersion(version string) *appQueryContextBuilder {
+	b.resourceVersion = version
+	return b
+}
+
+// withoutMultipleProjects 禁用多个项目支持（用于 Get 等只允许单个项目的接口）
+func (b *appQueryContextBuilder) withoutMultipleProjects() *appQueryContextBuilder {
+	b.allowMultipleProjects = false
+	return b
+}
+
+// withMultipleProjects 启用多个项目支持
+func (b *appQueryContextBuilder) withMultipleProjects() *appQueryContextBuilder {
+	b.allowMultipleProjects = true
+	return b
+}
+
+// build 构建 appQueryContext
+func (b *appQueryContextBuilder) build() (*appQueryContext, error) {
+	// 验证多个项目
+	if !b.allowMultipleProjects && len(b.queryProjects) > 1 {
+		return nil, status.Errorf(codes.InvalidArgument, "multiple projects specified - this endpoint accepts either zero or one project")
+	}
+
+	// 处理项目：优先使用单个项目，否则从多个项目中取第一个（如果有）
+	project := b.queryProject
+	if project == "" && len(b.queryProjects) > 0 {
+		project = b.queryProjects[0]
+	}
+
+	// 处理命名空间：为空时使用默认命名空间
+	namespace := b.s.appNamespaceOrDefault(b.queryNamespace)
+
+	// 获取 RBAC subject 和 claims
+	claims := b.ctx.Value("claims")
+	subject := session.Username(b.ctx)
+	if subject == "" {
+		subject = "Unknown user"
+	}
+
+	return &appQueryContext{
+		ctx:            b.ctx,
+		action:         b.action,
+		project:        project,
+		namespace:      namespace,
+		name:           b.queryName,
+		resourceVersion: b.resourceVersion,
+		claims:         claims,
+		subject:        subject,
+	}, nil
+}
+
+// getAppInformer 使用 informer 从查询上下文获取应用
+func (c *appQueryContext) getAppInformer(s *Server) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	return s.getApplicationEnforceRBACInformer(c.ctx, c.action, c.project, c.namespace, c.name)
+}
+
+// getAppClient 使用 client 从查询上下文获取应用
+func (c *appQueryContext) getAppClient(s *Server) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	return s.getApplicationEnforceRBACClient(c.ctx, c.action, c.project, c.namespace, c.name, c.resourceVersion)
+}
+
+// getAppProject 从应用获取项目
+func (c *appQueryContext) getAppProject(s *Server, app *v1alpha1.Application) (*v1alpha1.AppProject, error) {
+	logCtx := log.WithFields(map[string]any{
+		"user":        c.subject,
+		"application": c.name,
+		"namespace":   c.namespace,
+	})
+	return s.getAppProject(c.ctx, app, logCtx)
+}
+
+// getAppFromQuery 使用 ApplicationQuery 构建上下文并获取应用（informer）
+func (s *Server) getAppFromQueryInformer(ctx context.Context, action string, q *application.ApplicationQuery, allowMultipleProjects ...bool) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	builder := s.newAppQueryContextBuilder(ctx, action).
+		withProjectQuery(q.GetProject()).
+		withProjectsQuery(getProjectsFromApplicationQuery(*q)).
+		withNamespaceQuery(q.GetAppNamespace()).
+		withNameQuery(q.GetName()).
+		withResourceVersion(q.GetResourceVersion())
+	
+	if len(allowMultipleProjects) > 0 {
+		if allowMultipleProjects[0] {
+			builder.withMultipleProjects()
+		} else {
+			builder.withoutMultipleProjects()
+		}
+	} else {
+		// 默认允许多个项目（与 Get 等接口不同）
+		builder.withMultipleProjects()
+	}
+	
+	queryCtx, err := builder.build()
+	if err != nil {
+		return nil, nil, err
+	}
+	return queryCtx.getAppInformer(s)
+}
+
+// getAppFromQuery 使用 ApplicationQuery 构建上下文并获取应用（client）
+func (s *Server) getAppFromQueryClient(ctx context.Context, action string, q *application.ApplicationQuery, allowMultipleProjects ...bool) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	builder := s.newAppQueryContextBuilder(ctx, action).
+		withProjectQuery(q.GetProject()).
+		withProjectsQuery(getProjectsFromApplicationQuery(*q)).
+		withNamespaceQuery(q.GetAppNamespace()).
+		withNameQuery(q.GetName()).
+		withResourceVersion(q.GetResourceVersion())
+	
+	if len(allowMultipleProjects) > 0 {
+		if allowMultipleProjects[0] {
+			builder.withMultipleProjects()
+		} else {
+			builder.withoutMultipleProjects()
+		}
+	} else {
+		// 默认允许多个项目（与 Get 等接口不同）
+		builder.withMultipleProjects()
+	}
+	
+	queryCtx, err := builder.build()
+	if err != nil {
+		return nil, nil, err
+	}
+	return queryCtx.getAppClient(s)
+}
+
+// getAppFromDeleteRequest 使用 ApplicationDeleteRequest 构建上下文并获取应用
+func (s *Server) getAppFromDeleteRequest(ctx context.Context, q *application.ApplicationDeleteRequest) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	queryCtx, err := s.newAppQueryContextBuilder(ctx, rbac.ActionGet).
+		withProjectQuery(q.GetProject()).
+		withNamespaceQuery(q.GetAppNamespace()).
+		withNameQuery(q.GetName()).
+		build()
+	if err != nil {
+		return nil, nil, err
+	}
+	return queryCtx.getAppClient(s)
+}
+
+// getAppFromSyncRequest 使用 ApplicationSyncRequest 构建上下文并获取应用
+func (s *Server) getAppFromSyncRequest(ctx context.Context, q *application.ApplicationSyncRequest) (*v1alpha1.Application, *v1alpha1.AppProject, error) {
+	queryCtx, err := s.newAppQueryContextBuilder(ctx, rbac.ActionGet).
+		withProjectQuery(q.GetProject()).
+		withNamespaceQuery(q.GetAppNamespace()).
+		withNameQuery(q.GetName()).
+		build()
+	if err != nil {
+		return nil, nil, err
+	}
+	return queryCtx.getAppClient(s)
+}
