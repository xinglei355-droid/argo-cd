+type applicationQueryContext struct {
+	project       string
+	namespace     string
+	name          string
+	claims        any
+	rbacSubject   string
+	requestSource string
+}
+
+func (s *Server) newApplicationQueryContext(ctx context.Context, requestSource, project, namespace, name string) applicationQueryContext {
+	return applicationQueryContext{
+		project:       project,
+		namespace:     s.appNamespaceOrDefault(namespace),
+		name:          name,
+		claims:        ctx.Value("claims"),
+		rbacSubject:   applicationRBACSubject(ctx),
+		requestSource: applicationRequestSource(ctx, requestSource),
+	}
+}
+
+func (q applicationQueryContext) logFields() log.Fields {
+	return log.Fields{
+		"application":    q.name,
+		"namespace":      q.namespace,
+		"rbac-subject":   q.rbacSubject,
+		"request-source": q.requestSource,
+	}
+}
+
+func (q applicationQueryContext) rbacName(defaultNS string) string {
+	return security.RBACName(defaultNS, q.project, q.namespace, q.name)
+}
+
+func applicationRBACSubject(ctx context.Context) string {
+	claims := ctx.Value("claims")
+	if claims == nil {
+		return "Unknown subject"
+	}
+	if subjectClaims, ok := claims.(interface{ GetSubject() (string, error) }); ok {
+		subject, err := subjectClaims.GetSubject()
+		if err == nil && subject != "" {
+			return subject
+		}
+	}
+	if mapClaims, ok := claims.(*jwt.MapClaims); ok {
+		subject, err := mapClaims.GetSubject()
+		if err == nil && subject != "" {
+			return subject
+		}
+	}
+	return "Unknown subject"
+}
+
+func applicationRequestSource(ctx context.Context, fallback string) string {
+	if md, ok := metadata.FromIncomingContext(ctx); ok {
+		if requestSource := metadataValue(md, "grpcgateway-user-agent"); requestSource != "" {
+			return requestSource
+		}
+		if requestSource := metadataValue(md, "user-agent"); requestSource != "" {
+			return requestSource
+		}
+	}
+	return fallback
+}
+
+func metadataValue(md metadata.MD, key string) string {
+	values := md.Get(key)
+	if len(values) == 0 {
+		return ""
+	}
+	return values[0]
+}
+
